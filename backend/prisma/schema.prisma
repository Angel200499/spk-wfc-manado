generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Cafe {
  id             Int      @id @default(autoincrement())
  name           String
  address        String
  imageUrl       String
  wifiSpeed      Float
  powerOutlet    Int
  comfort        Float
  noiseLevel     Float
  averagePrice   Float
  openHours      Float
  createdAt      DateTime @default(now())
}